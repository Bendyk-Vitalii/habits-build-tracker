{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@habits-tracker/shared": ["./packages/shared/dist/index"],
      "@habits-tracker/shared/*": ["./packages/shared/dist/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
