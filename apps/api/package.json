{
  "name": "@habits-tracker/api",
  "version": "1.0.0",
  "private": true,
  "description": "Firebase Cloud Functions for Habits Build Tracker — push notifications & AI suggestions",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "web-push": "^3.6.0",
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "@habits-tracker/shared": "file:./habits-tracker-shared-1.0.0.tgz"
  },
  "devDependencies": {
    "typescript": "~5.7.0",
    "@types/web-push": "^3.6.0",
    "@types/cors": "^2.8.0"
  }
}
